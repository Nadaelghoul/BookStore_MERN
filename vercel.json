{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/users/(.*)", "destination": "/server.js" },
    { "source": "/books/(.*)", "destination": "/server.js" },
    { "source": "/category/(.*)", "destination": "/server.js" },
    { "source": "/admin/(.*)", "destination": "/server.js" },
    { "source": "/carts/(.*)", "destination": "/server.js" },
    { "source": "/images/(.*)", "destination": "/server.js" },
    { "source": "/users", "destination": "/server.js" },
    { "source": "/books", "destination": "/server.js" },
    { "source": "/category", "destination": "/server.js" },
    { "source": "/admin", "destination": "/server.js" },
    { "source": "/carts", "destination": "/server.js" },
    { "source": "/((?!api|users|books|category|admin|carts|images).* )", "destination": "/frontend/frontend/index.html" }
  ]
}
