{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/users",
      "destination": "/server.js"
    },
    {
      "source": "/users/:path*",
      "destination": "/server.js"
    },
    {
      "source": "/books",
      "destination": "/server.js"
    },
    {
      "source": "/books/:path*",
      "destination": "/server.js"
    },
    {
      "source": "/category",
      "destination": "/server.js"
    },
    {
      "source": "/category/:path*",
      "destination": "/server.js"
    },
    {
      "source": "/admin",
      "destination": "/server.js"
    },
    {
      "source": "/admin/:path*",
      "destination": "/server.js"
    },
    {
      "source": "/carts",
      "destination": "/server.js"
    },
    {
      "source": "/carts/:path*",
      "destination": "/server.js"
    },
    {
      "source": "/images/:path*",
      "destination": "/server.js"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/frontend/index.html"
    }
  ]
}